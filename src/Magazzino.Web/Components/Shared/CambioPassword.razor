@inject UtenteCorrente Utente
@inject Operazioni Op
@inject NavigationManager Nav

<h1>Cambia password</h1>
<Avviso Errore="@errore" />
<div class="@(Mobile ? "" : "panel")">
    <label class="field">Password attuale<input type="password" autocomplete="current-password" @bind="attuale" @bind:event="oninput" /></label>
    <label class="field">Nuova password<input type="password" autocomplete="new-password" @bind="nuova" @bind:event="oninput" /></label>
    <label class="field">Ripeti la nuova<input type="password" autocomplete="new-password" @bind="ripeti" @bind:event="oninput" /></label>
    <p class="muted">Dopo il cambio si rientra con la nuova password, anche sugli altri dispositivi.</p>
    <button class="btn primary @(Mobile ? "block" : "")" disabled="@(attuale == "" || nuova == "")" @onclick="Salva">Cambia password</button>
</div>

@code {
    [Parameter] public bool Mobile { get; set; }
    private string attuale = "", nuova = "", ripeti = "";
    private string? errore;

    private async Task Salva()
    {
        errore = null;
        if (nuova != ripeti) { errore = "Le due password nuove non coincidono."; return; }
        var id = await Utente.IdAsync();
        try
        {
            await Op.EseguiAsync(sp => sp.GetRequiredService<UtentiService>().CambiaPasswordAsync(id, attuale, nuova));
            Nav.NavigateTo("accesso", forceLoad: true); // la sessione vecchia non vale piu'
        }
        catch (MagazzinoException ex) { errore = ex.Message; }
    }
}
