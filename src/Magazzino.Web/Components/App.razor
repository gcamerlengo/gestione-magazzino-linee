<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <link rel="icon" href="data:," />
    <HeadOutlet @rendermode="ModoPagina" />
</head>

<body>
    <Routes @rendermode="ModoPagina" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // La pagina di accesso e' una pagina "statica" (form classico): solo cosi' puo' scrivere il cookie di accesso.
    private IComponentRenderMode? ModoPagina =>
        HttpContext.Request.Path.StartsWithSegments("/accesso") ? null : InteractiveServer;
}
