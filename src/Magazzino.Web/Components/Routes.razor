<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true) { <VaiAlLogin /> }
                else
                {
                    <div class="panel">
                        <h1>Accesso non consentito</h1>
                        <p>Il tuo ruolo non permette di aprire questa pagina.</p>
                        <a class="btn primary" href="@(context.User.IsInRole("Tecnico") ? "t" : "")">Torna all'inizio</a>
                    </div>
                }
            </NotAuthorized>
            <Authorizing><p class="muted">Caricamento...</p></Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
