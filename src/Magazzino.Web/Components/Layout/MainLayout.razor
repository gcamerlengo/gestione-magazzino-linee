@inherits LayoutComponentBase

<div class="shell">
    <nav class="nav">
        <div class="brand">Magazzino ricambi</div>
        <NavLink href="" Match="NavLinkMatch.All">Cruscotto</NavLink>
        <NavLink href="ordini">Ordini fornitore</NavLink>
        <NavLink href="giacenze">Giacenze</NavLink>
        <NavLink href="movimenti">Movimenti</NavLink>
        <NavLink href="arrivi">Arrivi da Risolvo</NavLink>
        <div class="nav-group">Anagrafiche</div>
        <NavLink href="ricambi">Ricambi</NavLink>
        <NavLink href="fornitori">Fornitori</NavLink>
        <NavLink href="ubicazioni">Ubicazioni</NavLink>
        <NavLink href="scatole">Scatole e QR</NavLink>
        <div class="nav-group">Tecnici</div>
        <NavLink href="t">App tecnici</NavLink>
        <AuthorizeView Policy="@Permessi.Amministrare">
            <div class="nav-group">Amministrazione</div>
            <NavLink href="utenti">Utenti e ruoli</NavLink>
        </AuthorizeView>
        <AuthorizeView>
            <div class="nav-user">
                <div><strong>@context.User.Identity?.Name</strong></div>
                <NavLink href="password">Cambia password</NavLink>
                <Esci Classe="btn sm" />
            </div>
        </AuthorizeView>
    </nav>
    <main class="content">
        @Body
    </main>
</div>

<div id="blazor-error-ui">
    Si e' verificato un errore imprevisto.
    <a href="" class="reload">Ricarica</a>
    <a class="dismiss">x</a>
</div>
