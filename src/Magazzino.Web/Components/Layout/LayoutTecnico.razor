@inherits LayoutComponentBase

<div class="mob">
    <header class="mob-top">
        <a href="t" class="mob-brand">Magazzino</a>
        <a href="t/interventi" class="mob-link">I miei interventi</a>
        <AuthorizeView Policy="@Permessi.Ufficio"><a href="" class="mob-link">Ufficio</a></AuthorizeView>
        <Esci Classe="mob-esci" />
